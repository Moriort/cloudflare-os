# Oretron OS - Environment Configuration
# Copy this file to .env and fill in the values

# Supabase Gatekeeper Configuration
# Create an OAuth app in your Supabase organization settings:
# https://supabase.com/dashboard/org/_/apps
SUPABASE_CLIENT_ID=<your-supabase-oauth-client-id>
SUPABASE_CLIENT_SECRET=<your-supabase-oauth-client-secret>

# Public base URL for OAuth callbacks
# For local development: http://localhost:8787
# For production: https://os.oretron.cl
PUBLIC_BASE_URL=http://localhost:8787

# Admin usernames (JSON array)
ADMINS=["admin"]

# Cloudflare Account ID (for Workers AI billing)
# CLOUDFLARE_ACCOUNT_ID=<your-cloudflare-account-id>

# AI Gateway Configuration (optional)
# AI_GATEWAY_URL=https://gateway.cloudflare-ai.com/v1

# Feature Flags
# DISABLE_PASSWORD_AUTH=false
# SIGNUPS_ENABLED=true
